# Сохраните копией как файл .env в этой же папке.

# SMTP (рекомендуется): строка подключения Nodemailer, например:
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=

# От кого (обязательно для SMTP_FROM при SMTP_URL)
SMTP_FROM="Факториалл КП <noreply@ваш-домен.ru>"
TRACKING_REPLY_TO=

# защита: тот же секрет пропишите в rates.js как TRACKING_WEBHOOK_SECRET
TRACKING_SECRET=

PORT=3847

# POST /parse-kp — парсинг КП через Claude (PDF base64 в JSON)
# ANTHROPIC_API_KEY=

# Альтернатива SMTP — Resend API (https://resend.com), приоритет ниже SMTP_URL:
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="KP <noreply@подтверждённый-домен>"
